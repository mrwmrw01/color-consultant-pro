# Color Consultant Pro - environment variables (see DEPLOY.md)
# Copy to .env for local development.

# Database (required). This URL matches docker-compose.yml.
DATABASE_URL="postgresql://colorapp:colorpass123@localhost:5432/color_consultant_dev"

# Authentication (required)
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
# Behind a proxy that sets the Host header (Render, Fly, nginx), set this
# instead of NEXTAUTH_URL so sign-in works on every domain the site answers on:
# AUTH_TRUST_HOST=true

# First admin login, created on start / `npm run db:seed` if no user has this email
# ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD="change-me-please"
# ADMIN_NAME="Your Name"

# Access control
ALLOW_PUBLIC_SIGNUP=false

# Photo storage
#   local - files under LOCAL_UPLOADS_DIR, served by the app (/api/files)
#   s3    - AWS S3 or an S3-compatible bucket (Cloudflare R2, Backblaze B2,
#           MinIO); set S3_ENDPOINT_URL for anything other than AWS
STORAGE_DRIVER=local
LOCAL_UPLOADS_DIR=./storage/uploads
# AWS_BUCKET_NAME="your-bucket"
# AWS_FOLDER_PREFIX=""
# AWS_ACCESS_KEY_ID="your-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-secret-access-key"
# AWS_REGION="auto"
# S3_ENDPOINT_URL="https://<account-id>.r2.cloudflarestorage.com"

# Image optimization for uploads
IMAGE_QUALITY=85
MAX_IMAGE_DIMENSION=2048

# Rate limiting, per user. Redis is optional: without REDIS_URL the limits are
# kept in memory, which is exact for a single app instance.
# REDIS_URL="redis://localhost:6379"
RATE_LIMIT_UPLOAD=60            # upload requests per hour (each can carry many photos)
RATE_LIMIT_PRESIGNED_URL=5000   # photo URL lookups per hour (one per photo shown)
